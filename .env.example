# Job Radar Environment Configuration

# Database Connection (SQLite async default, PostgreSQL in prod)
DATABASE_URL=sqlite+aiosqlite:///./job_radar.db

# Application Secret Key
SECRET_KEY=dev-secret-key-change-in-production

# Local Playwright Microservice Boundary
BROWSER_SERVICE_URL=ws://localhost:3013

# Job Ops Integration (Optional - Handoff disabled by default)
HANDOFF_ENABLED=false
JOBOPS_ENDPOINT=
JOBOPS_USERNAME=
JOBOPS_PASSWORD=

# Docker Compose database defaults
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=jobradar_secret
POSTGRES_DB=job_radar
